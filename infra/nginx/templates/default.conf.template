# nginx:alpine が起動時に envsubst で ${WAOON_DOMAIN} を展開し /etc/nginx/conf.d/default.conf を生成する。
# nginx 変数（$host / $remote_addr 等）は env に無いので置換されず温存される。

# :80 — ACME challenge を受けつつ、それ以外は HTTPS へリダイレクト。
server {
    listen 80;
    listen [::]:80;
    server_name ${WAOON_DOMAIN};

    # Let's Encrypt webroot challenge（certbot と共有する volume）。
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# :443 — TLS 終端 + Next.js(web) へ proxy。GoTrue はサーバ間通信のみなので公開しない。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${WAOON_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${WAOON_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WAOON_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # XFF 詐称対策（D-4）: クライアント送信の X-Forwarded-For を捨て、
    # edge が観測した実 IP で上書きする。getClientIp は XFF の先頭を信頼するため、
    # ここで単一の信頼できる値に固定することでレートリミット回避を防ぐ。
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_http_version 1.1;

    # 認証エンドポイントは nginx 一次レートリミット（zone=auth は 10-limits.conf）。
    # burst で瞬間的なスパイクを吸収しつつ、定常レートは 10r/m に収束させる。
    location /api/v1/auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://web:3000;
    }

    location / {
        proxy_pass http://web:3000;
    }
}
