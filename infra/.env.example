# infra スタックの dev 用 env。このファイルを infra/.env（gitignore 済み）にコピーして使う。
# compose も scripts も既定値を持たないため、infra/.env が無いと起動・migrate は失敗する。
# stg/prod は別 env / 別経路で配備する。

# PostgreSQL
PG_PORT=5432
PG_DATABASE=wanonwan
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres
# public スキーマ用ロール（apps/web・pgTAP 接続用）。00_bootstrap.sql のパスワードと一致させる。
APP_DB_PASSWORD=app
# auth スキーマ所有ロール（GoTrue 接続用）。00_bootstrap.sql のパスワードと一致させる。
AUTH_ADMIN_PASSWORD=authadmin

# MinIO（添付ファイルのオブジェクトストレージ）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BUCKET=wanonwan

# 自前ホスト埋め込み（profile ai、AI メンター提案用）
EMBEDDINGS_PORT=8081

# GoTrue
GOTRUE_PORT=9999
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:9999
# 32 バイト以上。dev 専用。stg/prod は必ず差し替える。
JWT_SECRET=dev-only-change-me-please-32bytes-minimum
