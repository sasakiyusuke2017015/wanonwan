# infra スタックの dev デフォルト。実値は infra/.env（gitignore 済み）に置く。
# stg/prod は別 env / 別経路で配備（技術選定メモ「secrets 管理」）。
# compose は未設定でも ${VAR:-default} で起動できる（この例は上書き用）。

# PostgreSQL
PG_PORT=5432
PG_DATABASE=waoon
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres
# auth スキーマ所有ロール（GoTrue 接続用）。00_bootstrap.sql のパスワードと一致させる。
AUTH_ADMIN_PASSWORD=authadmin

# GoTrue
GOTRUE_PORT=9999
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:9999
# 32 バイト以上。dev 専用。stg/prod は必ず差し替える。
JWT_SECRET=dev-only-change-me-please-32bytes-minimum
