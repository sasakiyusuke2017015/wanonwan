# apps/worker（添付 GC worker）の本番 image。Next standalone と違い plain Node。
# build context はリポジトリ root（pnpm モノレポ）。
#   docker build -f infra/Dockerfile.worker -t waoon-worker .

# ---- base: pnpm を有効化した node ----
FROM node:24-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# ---- deps: worker とその workspace 依存だけを解決 ----
# frozen-lockfile は全 workspace の manifest を要求するため、全 package.json を先に copy。
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/ packages/
RUN pnpm install --frozen-lockfile --prod --filter "@waoon/worker..."
COPY apps/worker apps/worker

# ---- runner: workspace 構造をそのまま載せた最小イメージ ----
# `pnpm deploy` で自己完結ディレクトリへ畳まない: workspace package (@waoon/storage) が
# node_modules 配下の実体としてコピーされると、Node が type-stripping を拒否する
# (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING)。symlink のまま運ぶと realpath が
# packages/ 側に解決されるため、dev と同じく TS を直接実行できる。
FROM base AS runner
ENV NODE_ENV=production
# 非 root（node イメージ同梱の node ユーザー）。
USER node
COPY --from=deps --chown=node:node /app ./
# worker は tsc build せず、Node の type-stripping で TS を直接実行する（dev の start と同一）。
CMD ["node", "apps/worker/src/main.ts"]
