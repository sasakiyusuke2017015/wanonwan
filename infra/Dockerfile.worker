# apps/worker（添付 GC worker）の本番 image。Next standalone と違い plain Node。
# build context はリポジトリ root（pnpm モノレポ）。
#   docker build -f infra/Dockerfile.worker -t waoon-worker .

# ---- base: pnpm を有効化した node ----
FROM node:24-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# ---- deps: lockfile から依存解決 → worker を自己完結ディレクトリへ deploy ----
# frozen-lockfile は全 workspace の manifest を要求するため、全 package.json を先に copy。
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/ packages/
RUN pnpm install --frozen-lockfile
COPY apps/worker apps/worker
# pnpm v10 は injected でない workspace の deploy に --legacy が要る（外部依存のみなので問題ない）。
RUN pnpm --filter @waoon/worker deploy --prod --legacy /app/deployed

# ---- runner: self-contained な deployed のみ載せた最小イメージ ----
FROM base AS runner
ENV NODE_ENV=production
# 非 root（node イメージ同梱の node ユーザー）。
USER node
COPY --from=deps --chown=node:node /app/deployed ./
# worker は tsc build せず、Node の type-stripping で TS を直接実行する（dev の start と同一）。
CMD ["node", "src/main.ts"]
