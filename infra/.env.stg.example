# infra/.env.stg.example — staging の env テンプレート（プレースホルダのみ）。
# 実値は infra/.env.stg に置く（.gitignore 済み）。secrets はリポジトリに入れない。
# このファイルは値を埋めずにコミットする（キーの一覧と説明だけを共有する）。
#
# 使い方（stg server, Linux）:
#   cp infra/.env.stg.example infra/.env.stg   # 実値を埋める
#   pnpm compose:stg:up                        # 起動前に scripts/check-secrets.mjs が走る

# ── ドメイン / TLS ──
WAOON_DOMAIN=stg.waoon.example.com        # nginx server_name / certbot 取得対象
CERTBOT_EMAIL=ops@example.com             # Let's Encrypt 登録メール

# ── 公開 URL（GoTrue / アプリ）──
SITE_URL=https://stg.waoon.example.com
API_EXTERNAL_URL=https://stg.waoon.example.com

# ── web image（GHCR。CD が WEB_IMAGE_TAG を更新する）──
WEB_IMAGE=ghcr.io/sasakiyusuke2017015/waoon-web
WEB_IMAGE_TAG=develop

# ── secrets（必須・空のままなら check-secrets が拒否し compose も起動失敗）──
# secret 値に '#' やクオート(" ')を含めないこと（env パーサが行末コメント扱いし得る）。
JWT_SECRET=                               # 32 バイト以上。例: openssl rand -base64 48
PG_SUPERUSER_PASSWORD=                    # postgres superuser のパスワード
AUTH_ADMIN_PASSWORD=                      # supabase_auth_admin。initdb の 05_rotate_roles.sh で適用
APP_DB_PASSWORD=                          # app_user。initdb で適用 + DATABASE_URL に埋め込む（URL 安全な英数字推奨）

# ── DB 接続（内部ロールのみ。postgres はネットワーク非公開。DATABASE_URL は compose が APP_DB_PASSWORD から組み立てる）──
PG_DATABASE=waoon                         # 変更不可（pg_cron が cron.database_name=waoon 前提）
PG_SUPERUSER=postgres
GOTRUE_URL=http://gotrue:9999             # web→gotrue は compose 内部ネットワーク

# ── 添付（MinIO）──
# storage サブドメインは DNS A レコードを stg server に向け、cert の SAN に含めること
# （certbot 発行時に -d ${WAOON_DOMAIN} -d ${WAOON_STORAGE_DOMAIN}。詳細 infra/nginx/README.md）。
WAOON_STORAGE_DOMAIN=storage.stg.waoon.example.com      # nginx server_name（添付の公開ホスト）
STORAGE_ENDPOINT=https://storage.stg.waoon.example.com  # presigned URL の署名先（browser-reachable）
STORAGE_BUCKET=waoon                      # 初回アップロード時に ensureBucket が冪等作成
MINIO_ROOT_USER=                          # MinIO root ユーザ（= STORAGE_ACCESS_KEY）
MINIO_ROOT_PASSWORD=                      # MinIO root パスワード（= STORAGE_SECRET_KEY。dev 既定 minioadmin 不可）
