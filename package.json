{
  "name": "waoon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @waoon/web dev",
    "build": "pnpm --filter @waoon/web build",
    "start": "pnpm --filter @waoon/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "echo \"lint: 後続フェーズ(Phase 6 CI)で設定\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "db:build": "docker compose -f infra/docker-compose.yml build",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:psql": "docker compose -f infra/docker-compose.yml exec postgres psql -U postgres -d waoon",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.9.0"
  }
}
