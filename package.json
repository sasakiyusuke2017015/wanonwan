{
  "name": "wanonwan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @wanonwan/web dev",
    "build": "turbo run build",
    "start": "pnpm --filter @wanonwan/web start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check:merges": "node scripts/check-merge-targets.mjs",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "clean": "rimraf -g node_modules \"apps/*/node_modules\" \"packages/*/node_modules\" .turbo \"apps/*/.next\" \"apps/*/.turbo\" \"packages/*/.turbo\" packages/ui/storybook-static",
    "clean:build": "rimraf -g .turbo \"apps/*/.next\" \"apps/*/.turbo\" \"packages/*/.turbo\" packages/ui/storybook-static",
    "clean:cache": "pnpm store prune",
    "compose:dev:build": "docker compose -f infra/docker-compose.yml build",
    "compose:dev:up": "docker compose -f infra/docker-compose.yml up -d --wait && pnpm run db:migrate && pnpm --filter @wanonwan/web dev",
    "compose:dev:down": "node scripts/kill-web.mjs && docker compose -f infra/docker-compose.yml down",
    "compose:dev:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "compose:ai:up": "docker compose -f infra/docker-compose.yml --profile ai up -d --wait",
    "worker:start": "pnpm --filter @wanonwan/worker start",
    "db:psql": "node scripts/db-psql.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:db": "node scripts/db-test.mjs",
    "check:secrets:stg": "node scripts/check-secrets.mjs infra/.env.stg",
    "check:secrets:prod": "node scripts/check-secrets.mjs infra/.env.prod",
    "compose:stg:build": "docker compose --env-file infra/.env.stg -f infra/docker-compose.stg.yml build",
    "compose:stg:pull": "docker compose --env-file infra/.env.stg -f infra/docker-compose.stg.yml pull",
    "compose:stg:up": "node scripts/check-secrets.mjs infra/.env.stg && docker compose --env-file infra/.env.stg -f infra/docker-compose.stg.yml up -d",
    "compose:stg:down": "docker compose --env-file infra/.env.stg -f infra/docker-compose.stg.yml down",
    "compose:stg:logs": "docker compose --env-file infra/.env.stg -f infra/docker-compose.stg.yml logs -f",
    "compose:stg:migrate": "node scripts/db-migrate.mjs --compose-file infra/docker-compose.stg.yml --env-file infra/.env.stg",
    "compose:prod:build": "docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml build",
    "compose:prod:pull": "docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml pull",
    "compose:prod:up": "node scripts/check-secrets.mjs infra/.env.prod && docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml up -d",
    "compose:prod:down": "docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml down",
    "compose:prod:logs": "docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml logs -f",
    "compose:prod:migrate": "node scripts/db-migrate.mjs --compose-file infra/docker-compose.prod.yml --env-file infra/.env.prod",
    "provision:dev": "node scripts/provision.mjs --env dev",
    "provision:dev:master": "node scripts/provision.mjs --env dev --step master",
    "provision:dev:user": "node scripts/provision.mjs --env dev --step user",
    "provision:dev:demo": "node scripts/provision.mjs --env dev --step demo",
    "provision:dev:fixture": "node scripts/provision.mjs --env dev --step fixture",
    "provision:stg": "node scripts/provision.mjs --env stg",
    "provision:stg:master": "node scripts/provision.mjs --env stg --step master",
    "provision:stg:user": "node scripts/provision.mjs --env stg --step user",
    "provision:stg:demo": "node scripts/provision.mjs --env stg --step demo",
    "provision:prod": "node scripts/provision.mjs --env prod",
    "provision:prod:master": "node scripts/provision.mjs --env prod --step master",
    "provision:prod:user": "node scripts/provision.mjs --env prod --step user",
    "deprovision:dev:master": "node scripts/provision.mjs --env dev --remove --step master",
    "deprovision:dev:user": "node scripts/provision.mjs --env dev --remove --step user",
    "deprovision:dev:demo": "node scripts/provision.mjs --env dev --remove --step demo",
    "deprovision:stg:master": "node scripts/provision.mjs --env stg --remove --step master",
    "deprovision:stg:demo": "node scripts/provision.mjs --env stg --remove --step demo",
    "deprovision:prod:master": "node scripts/provision.mjs --env prod --remove --step master",
    "db:snapshot": "node scripts/db-snapshot.mjs"
  },
  "devDependencies": {
    "csv-parse": "^7.0.1",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  }
}
