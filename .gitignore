# 依存・ビルド成果物
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
coverage/
.turbo/

# 環境・シークレット
.env
.env.*
!.env.example
# *.example テンプレートは追跡対象に戻す（.env.* に巻き込まれないように）。実値ファイルのみ無視。
!.env.*.example
.claude/settings.local.json

# provision の初期パスワード出力（一時 PW・配布後に削除する。VCS に入れない）
provision-credentials-*.txt
# stg/prod 人員 CSV（実メール = PII を VCS に入れない。--users-csv で外部パス指定）
staff*.csv
*-staff.csv

# アーカイブ（旧 1on1 ソース・参照用 zip）は参照のみ・リポジトリには含めない
docs/99_archive/legacy-1on1/
docs/99_archive/*.zip

# Next.js / TypeScript 生成物
next-env.d.ts
*.tsbuildinfo

# OS / エディタ
.DS_Store
*.log

# ui-catalog 上流同期の作業用 zip (取り込み後は不要)
/ui*.zip

# packages/* を書き出した受け渡し用 zip (ローカル作業用・リポジトリには含めない)
/db.zip
/storage.zip
