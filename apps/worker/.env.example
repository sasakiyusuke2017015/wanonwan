# apps/worker（添付 GC worker）の dev 用 env（実値は apps/worker/.env = gitignore に置く）。
# `pnpm worker:start` が .env を読む（存在しなければ読まない）。stg/prod は compose が注入する。

# pgmq の read/delete には特権が要るため superuser で接続する（保守デーモン）。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waoon

# MinIO。worker は presign せず DeleteObject のみ行うため、内部到達できる endpoint を指定する。
# 既定値は無い（未設定なら起動時に落ちる）。dev は host から compose の MinIO を叩く。
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# GC のポーリング挙動（省略可）
# GC_QUEUE=attachment_gc
# GC_VISIBILITY_SECONDS=30
# GC_BATCH=10
# GC_IDLE_MS=5000
# GC_ERROR_MS=10000
