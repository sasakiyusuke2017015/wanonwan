# apps/web の dev 用 env（実値は apps/web/.env.local = gitignore に置く）。
# 未設定でも下記既定値（infra/docker-compose.yml と一致）で dev 動作する。

# GoTrue のベース URL（ローカルは compose の :9999）
GOTRUE_URL=http://localhost:9999
# GoTrue の access_token 検証に使う共有鍵。infra の JWT_SECRET と必ず一致させる。
# dev 既定値。stg/prod は必ず差し替える。
GOTRUE_JWT_SECRET=dev-only-change-me-please-32bytes-minimum

# MinIO（添付ファイル）。presigned URL は browser-reachable な STORAGE_ENDPOINT で署名する。
# dev は localhost:9000（compose の MinIO）。stg/prod は nginx 経由の公開ホストに差し替える。
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=waoon
