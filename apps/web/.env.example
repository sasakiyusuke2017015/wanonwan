# apps/web の dev 用 env（実値は apps/web/.env.local = gitignore に置く）。
# STORAGE_* は既定値を持たない（未設定だと添付 API が起動時に落ちる）。dev でも .env.local を作ること。

# GoTrue のベース URL（ローカルは compose の :9999）
GOTRUE_URL=http://localhost:9999
# GoTrue の access_token 検証に使う共有鍵。infra の JWT_SECRET と必ず一致させる。
# dev 既定値。stg/prod は必ず差し替える。
GOTRUE_JWT_SECRET=dev-only-change-me-please-32bytes-minimum

# MinIO（添付ファイル）。presigned URL は browser-reachable な STORAGE_ENDPOINT で署名する。
# dev は localhost:9000（compose の MinIO）。stg/prod は nginx 経由の公開ホストに差し替える。
STORAGE_ENDPOINT=http://localhost:9000
# server 側の実通信（HeadObject / DeleteObject / bucket 作成）用。省略時は STORAGE_ENDPOINT を使う。
# dev は web を host で動かすため省略でよい。compose 内で動かす stg/prod は http://minio:9000。
# STORAGE_INTERNAL_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=wanonwan

# AI 機能（面談要約）。**未設定なら AI 機能は無効**（外部送信は一切発生しない）。
# キーを入れる = 面談データを Anthropic(Claude) へ送ることを有効化する組織判断（Plan §3.1）。
# 設定は組織のプライバシー承認後に限る。
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# 外部送信の二重 gate。key に加えてこのフラグが true のときだけ AI 機能を有効化する。
# key だけでは有効化しない（テスト目的で key が紛れても送信されない fail-safe）。組織承認後のみ true。
AI_EXTERNAL_PROCESSING_APPROVED=false

# 自前ホスト埋め込み（AI メンター提案の RAG）。未設定なら提案機能は無効（503）。
# 起動: pnpm compose:ai:up（profile ai の embeddings コンテナ）。次元はモデル依存（e5-small=384）。
EMBEDDINGS_URL=http://localhost:8081
EMBEDDINGS_DIM=384
